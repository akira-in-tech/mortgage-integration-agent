# ── Decision provider ──────────────────────────────────────────────────────────
# rules: deterministic local simulation (default, no model required)
# ollama: local open-weight model through Ollama (no cloud API key)
DECISION_PROVIDER=rules

# ── Local Ollama ───────────────────────────────────────────────────────────────
# Used only when DECISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=60000

# ── PostgreSQL connection string ───────────────────────────────────────────────
# Required. Validated at startup — must start with postgres:// or postgresql://.
# This is also the role the migration CLI runs as, so it needs real DDL
# rights (and, today, also has to be able to run synchronize in
# development — see NODE_ENV below).
DATABASE_URL=postgresql://localhost:5432/mortgage_agent

# ── Application runtime database role (production only, M5-003) ────────────────
# Optional. Used only when NODE_ENV=production. A restricted, non-superuser
# role with plain DML grants (no DDL) — the `AppRuntimeRole` migration
# provisions one named `mortgage_app`. Without this, production falls back
# to DATABASE_URL's own (migration) role, which logs a warning at boot and
# means row-level security on webhook_endpoints/webhook_deliveries (M5-002)
# provides no real protection if that role is a superuser or has
# BYPASSRLS, since PostgreSQL lets both silently ignore RLS policies.
# APP_DATABASE_URL=postgresql://mortgage_app:CHANGE_ME@localhost:5432/mortgage_agent

# ── Application port ───────────────────────────────────────────────────────────
# Optional, defaults to 3000. Validated at startup as an integer in 1-65535.
PORT=3000

# ── Node environment ───────────────────────────────────────────────────────────
# Optional, defaults to development. Validated at startup — must be one of:
# development | test | staging | production.
# production disables the GraphQL playground/introspection and TypeORM
# schema auto-synchronization; there is no partial-credit spelling of it.
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Optional, comma-separated http(s):// origins. Unset: development allows
# any http://localhost:<port>; every other environment allows none until
# this is configured.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://console.example.com

# ── Rate limiting ───────────────────────────────────────────────────────────
# Optional. Applies per client IP to every route except /health/*.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=100

# ── Temporal ────────────────────────────────────────────────────────────────
# Optional. Used by both the API process (to start/signal workflows) and
# the worker process (npm run start:worker) — see docker-compose.yml's
# `temporal` service, or run `docker compose up temporal` for local dev
# without the rest of the stack.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── OIDC (Section 16.1: "OIDC/OAuth 2.0 for people", M5-024) ────────────────
# Optional — both unset means OidcGuard always fails closed with a clean
# 401; the machine api_clients credential path is completely unaffected
# either way. docker-compose.yml ships a real, self-hosted Keycloak for
# local use, seeded with a real realm/client/test user from
# keycloak/realm-export.json (run `docker compose up keycloak` for that
# service alone). A request must also carry the tenant it's acting in via
# an X-Tenant-Id header — a real person can hold tenant_memberships in
# more than one tenant, unlike a single-tenant api_client.
OIDC_ISSUER_URL=http://localhost:8080/realms/mortgage-agent
OIDC_AUDIENCE=mortgage-agent-app
