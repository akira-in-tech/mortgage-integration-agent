# ── Decision provider ──────────────────────────────────────────────────────────
# rules: deterministic local simulation (default, no model required)
# ollama: local open-weight model through Ollama (no cloud API key)
DECISION_PROVIDER=rules

# ── Local Ollama ───────────────────────────────────────────────────────────────
# Used only when DECISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=60000

# ── PostgreSQL connection string ───────────────────────────────────────────────
# Required. Validated at startup — must start with postgres:// or postgresql://.
DATABASE_URL=postgresql://localhost:5432/mortgage_agent

# ── Application port ───────────────────────────────────────────────────────────
# Optional, defaults to 3000. Validated at startup as an integer in 1-65535.
PORT=3000

# ── Node environment ───────────────────────────────────────────────────────────
# Optional, defaults to development. Validated at startup — must be one of:
# development | test | staging | production.
# production disables the GraphQL playground/introspection and TypeORM
# schema auto-synchronization; there is no partial-credit spelling of it.
NODE_ENV=development
