# ── Decision provider ──────────────────────────────────────────────────────────
# rules: deterministic local simulation (default, no model required)
# ollama: local open-weight model through Ollama (no cloud API key)
DECISION_PROVIDER=rules

# ── Local Ollama ───────────────────────────────────────────────────────────────
# Used only when DECISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=60000

# ── PostgreSQL connection string ───────────────────────────────────────────────
# Required. Validated at startup — must start with postgres:// or postgresql://.
DATABASE_URL=postgresql://localhost:5432/mortgage_agent

# ── Application port ───────────────────────────────────────────────────────────
# Optional, defaults to 3000. Validated at startup as an integer in 1-65535.
PORT=3000

# ── Node environment ───────────────────────────────────────────────────────────
# Optional, defaults to development. Validated at startup — must be one of:
# development | test | staging | production.
# production disables the GraphQL playground/introspection and TypeORM
# schema auto-synchronization; there is no partial-credit spelling of it.
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Optional, comma-separated http(s):// origins. Unset: development allows
# any http://localhost:<port>; every other environment allows none until
# this is configured.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://console.example.com

# ── Rate limiting ───────────────────────────────────────────────────────────
# Optional. Applies per client IP to every route except /health/*.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=100

# ── Temporal ────────────────────────────────────────────────────────────────
# Optional. Used by both the API process (to start/signal workflows) and
# the worker process (npm run start:worker) — see docker-compose.yml's
# `temporal` service, or run `docker compose up temporal` for local dev
# without the rest of the stack.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
