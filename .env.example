# ── Decision provider ──────────────────────────────────────────────────────────
# rules: deterministic local simulation (default, no model required)
# ollama: local open-weight model through Ollama (no cloud API key)
DECISION_PROVIDER=rules

# ── Local Ollama ───────────────────────────────────────────────────────────────
# Used only when DECISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=60000
# The LangGraph planner reserves this full amount before its local model call;
# hidden thinking is disabled and output is capped separately.
AGENT_PLANNER_TOKEN_BUDGET=1024
AGENT_PLANNER_MAX_OUTPUT_TOKENS=128
AGENT_PLANNER_MIN_CONFIDENCE_BPS=8000

# ── PostgreSQL connection string ───────────────────────────────────────────────
# Required. Validated at startup — must start with postgres:// or postgresql://.
# This is also the role the migration CLI runs as, so it needs real DDL
# rights (and, today, also has to be able to run synchronize in
# development — see NODE_ENV below).
DATABASE_URL=postgresql://localhost:5432/mortgage_agent

# ── Application runtime database role (deployment, M5-003) ─────────────────────
# Required when NODE_ENV=staging or production. A restricted, non-superuser
# role with plain DML grants (no DDL) — the `AppRuntimeRole` migration
# provisions one named `mortgage_app`. Startup fails when this is missing or
# identical to DATABASE_URL, preventing a migration/superuser credential from
# silently bypassing PostgreSQL row-level-security policies.
# APP_DATABASE_URL=postgresql://mortgage_app:CHANGE_ME@localhost:5432/mortgage_agent

# ── Application port ───────────────────────────────────────────────────────────
# Optional, defaults to 3000. Validated at startup as an integer in 1-65535.
PORT=3000

# ── Node environment ───────────────────────────────────────────────────────────
# Optional, defaults to development. Validated at startup — must be one of:
# development | test | staging | production.
# staging and production disable TypeORM schema auto-synchronization;
# production also disables GraphQL playground/introspection.
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Optional, comma-separated http(s):// origins. Unset: development allows
# any http://localhost:<port>; every other environment allows none until
# this is configured.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://console.example.com

# ── Rate limiting ───────────────────────────────────────────────────────────
# Optional. Applies per client IP to every route except /health/*.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=100

# ── Temporal ────────────────────────────────────────────────────────────────
# Optional. Used by both the API process (to start/signal workflows) and
# the worker process (npm run start:worker) — see docker-compose.yml's
# `temporal` service, or run `docker compose up temporal` for local dev
# without the rest of the stack.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Borrower-derived field encryption and backup expiry ───────────────────
# Ordered key ring: the first AES-256-GCM key encrypts provider receipts,
# normalized findings, and evidence values; later keys support zero-downtime
# decryption during rotation. Required in staging/production. The variable name
# is retained for deployment compatibility even though its scope is broader.
# PROVIDER_DATA_ENCRYPTION_KEYS=provider-v1:<64-hex-characters>
# Must match the authoritative database-backup retention policy.
BACKUP_RETENTION_HOURS=24

# ── OpenTelemetry ──────────────────────────────────────────────────────────
# Disabled by default: local development and CI need no collector or API key.
# Enable to export OTLP/HTTP traces and metrics to the self-hosted collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=mortgage-integration-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_TRACE_SAMPLE_RATIO=1

# ── OIDC (Section 16.1: "OIDC/OAuth 2.0 for people", M5-024) ────────────────
# Optional — both unset means OidcGuard always fails closed with a clean
# 401; the machine api_clients credential path is completely unaffected
# either way. docker-compose.yml ships a real, self-hosted Keycloak for
# local use, seeded with a real realm/client/test user from
# keycloak/realm-export.json (run `docker compose up keycloak` for that
# service alone). A request must also carry the tenant it's acting in via
# an X-Tenant-Id header — a real person can hold tenant_memberships in
# more than one tenant, unlike a single-tenant api_client.
OIDC_ISSUER_URL=http://localhost:8080/realms/mortgage-agent
OIDC_AUDIENCE=mortgage-agent-app
# The console uses a same-origin backend-for-frontend session. OAuth provider
# tokens are encrypted in PostgreSQL and never returned to browser JavaScript.
OIDC_CLIENT_ID=mortgage-agent-app
OIDC_CALLBACK_URL=http://localhost:5173/v1/auth/session/callback
CONSOLE_ORIGIN=http://localhost:5173
# Disabled by default. Staging enables this only with Cognito email
# verification; each verified account receives its own empty PARTNER tenant.
SELF_SERVICE_SIGNUP_ENABLED=false
# Local development may omit this key. Staging/production must inject a unique
# 32-byte key encoded as 64 hex characters (for example: openssl rand -hex 32).
# OIDC_SESSION_ENCRYPTION_KEY=
OIDC_SESSION_MAX_AGE_SECONDS=28800
