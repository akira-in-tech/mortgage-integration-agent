{
  "realm": "mortgage-agent",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "mortgage-agent-app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "audience-mortgage-agent-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mortgage-agent-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "40000000-0000-4000-8000-000000000004",
      "username": "reviewer@example.com",
      "email": "reviewer@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Reviewer",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "reviewer-dev-password",
          "temporary": false
        }
      ]
    }
  ]
}
