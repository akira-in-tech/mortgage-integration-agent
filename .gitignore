# Dependencies
node_modules/

# Build output
dist/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Coverage
coverage/

# Jest cache
.jest-cache/

# Local agent session state
.claude/

# GraphQL generated schema (regenerated on start)
src/schema.gql

# Generated evaluation reports (Section 18.2) — reproducible from
# evaluation/cases/ + npm run evaluate, not durable source content.
evaluation/reports/*.json

# Stray compiled output if client/*.ts is ever accidentally run through
# tsc directly instead of ts-node — client/generated/schema.d.ts (the
# real generated artifact) is unaffected, it isn't a compiled sibling of
# a .ts file.
client/*.js
client/*.js.map
client/index.d.ts
client/quickstart.d.ts
