{
  "name": "mortgage-integration-agent",
  "version": "1.0.0",
  "description": "AI-powered mortgage integration orchestration service",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint \"{src,apps,libs,test,client}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,client}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --no-watchman",
    "demo": "node demo.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "evaluate": "ts-node -r tsconfig-paths/register src/evaluation-report.ts",
    "generate:openapi": "ts-node -r tsconfig-paths/register src/generate-openapi-spec.ts",
    "create-api-client": "ts-node -r tsconfig-paths/register src/create-api-client.ts",
    "set-tenant-agent-budget": "ts-node -r tsconfig-paths/register src/set-tenant-agent-budget.ts",
    "set-provider-status": "ts-node -r tsconfig-paths/register src/set-provider-status.ts",
    "seed-communication-template": "ts-node -r tsconfig-paths/register src/seed-communication-template.ts",
    "manage-legal-hold": "ts-node -r tsconfig-paths/register src/manage-legal-hold.ts",
    "resolve-data-disposition-task": "ts-node -r tsconfig-paths/register src/resolve-data-disposition-task.ts",
    "resolve-provider-operation-intent": "ts-node -r tsconfig-paths/register src/resolve-provider-operation-intent.ts",
    "manage-provider-promotion": "ts-node -r tsconfig-paths/register src/manage-provider-promotion.ts",
    "manage-user": "ts-node -r tsconfig-paths/register src/manage-user.ts",
    "generate:client": "openapi-typescript openapi/openapi.json -o client/generated/schema.d.ts",
    "quickstart": "ts-node -r tsconfig-paths/register client/quickstart.ts",
    "webhook-inspector": "ts-node -r tsconfig-paths/register client/webhook-inspector.ts",
    "scenario-catalog": "ts-node -r tsconfig-paths/register client/scenario-catalog.ts"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@nestjs/apollo": "^13.4.4",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/common": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "^8.3.0",
    "jose": "^4.15.9",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@temporalio/testing": "^1.22.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "watchman": false,
    "transform": {
      "^.+\\.ts$": "<rootDir>/../test/jest-ts-transformer.cjs"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
